# Copia en AWS S3 (tarea 44, copia 3b). Copiar a /root/.config/backup-odoo/s3.env en el servidor (chmod 600)
# con los valores reales. Las claves son de un usuario IAM que SOLO puede usar este bucket (ver DOCUMENTACION.md).
REPO_S3=s3:s3.us-east-1.amazonaws.com/almi-chain-backup-2026/restic
AWS_ACCESS_KEY_ID=<id de la clave del usuario IAM>
AWS_SECRET_ACCESS_KEY=<clave secreta del usuario IAM>
# Solo en el Learner Lab (no deja crear usuarios IAM): las credenciales temporales del lab llevan además el token.
# AWS_SESSION_TOKEN=<token de la sesión del lab>
AWS_DEFAULT_REGION=us-east-1
